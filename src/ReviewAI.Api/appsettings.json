{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "Model": "claude-sonnet-4-5",
    "MaxTokens": 2048,
    "Temperature": 0.2
  },
  "Resilience": {
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 2,
    "AttemptTimeoutSeconds": 30,
    "TotalTimeoutSeconds": 120
  },
  "ApiKeyAuth": {
    "HeaderName": "X-API-Key"
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60,
    "QueueLimit": 0
  }
}
